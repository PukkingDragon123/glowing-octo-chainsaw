{
  "name": "xolotl-kobini",
  "private": true,
  "version": "0.1.0",
  "description": "A 3D pixel-art convenience store where every product turns your link, image or video into a QR code.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
